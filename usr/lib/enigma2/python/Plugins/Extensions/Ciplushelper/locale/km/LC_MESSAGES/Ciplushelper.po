msgstr "ផ្អាក CI 1"

msgid "Pause CI 2"
msgstr "ផ្អាក CI 2"

msgid "Remove /etc/ciplus"
msgstr "លុប /etc/ciplus"

msgid "Restart service!"
msgstr "ចាប់ផ្តើមសេវាកម្មឡើងវិញ!"

