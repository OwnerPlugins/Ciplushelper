msgstr "កម្មវិធីជំនួយ CI+"

msgid "CI+ Helper status:"
msgstr "ស្ថានភាពជំនួយ CI+៖"

msgid "Common Interface Assignment plugin not found. Please install it from System Plugins."
msgstr "រកមិនឃើញកម្មវិធីជំនួយការចាត់តាំងចំណុចប្រទាក់ទូទៅទេ។ សូមដំឡើងវាពីកម្មវិធីជំនួយប្រព័ន្ធ។"

msgid "Disable ciplushelper autostart"
msgstr "បិទដំណើរការ ciplushelper autostart"

msgid "Enable auto-check module"
msgstr "បើកម៉ូឌុលពិនិត្យដោយស្វ័យប្រវត្តិ"

msgid "Enable ciplushelper autostart"
msgstr "បើកដំណើរការ ciplushelper autostart"

msgid "ERROR: CI+ Helper not running!\nCheck /home/root/ciplus_debug.log"
msgstr "កំហុស៖ CI+ Helper មិនដំណើរការទេ!\nCheck /home/root/ciplus_debug.log"

msgid "Install /etc/ciplus"
msgstr "ដំឡើង /etc/ciplus"

msgid "Install alternative binary (zgemma-arm)"
msgstr "ដំឡើងប្រព័ន្ធគោលពីរជំនួស (zgemma-arm)"

msgid "Install WORKING binary (hd51/6.new)"
msgstr "ដំឡើងប្រព័ន្ធគោលពីរ WORKING (hd51/6.new)"

