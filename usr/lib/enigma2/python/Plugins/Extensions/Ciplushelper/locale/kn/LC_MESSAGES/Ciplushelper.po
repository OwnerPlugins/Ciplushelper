msgstr "ಡೀಫಾಲ್ಟ್ ಆವೃತ್ತಿ"

msgid "Disable"
msgstr "ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ"

msgid "Disable ciplushelper autostart"
msgstr "ciplushelper ಸ್ವಯಂಪ್ರಾರಂಭವನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ"

msgid "Enable"
msgstr "ಸಕ್ರಿಯಗೊಳಿಸಿ"

msgid "Enable ciplushelper autostart"
msgstr "ciplushelper ಸ್ವಯಂಪ್ರಾರಂಭವನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ"

