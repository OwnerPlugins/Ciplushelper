msgstr "GUI ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ"

msgid "Start ciplushelper"
msgstr "ciplushelper ಅನ್ನು ಪ್ರಾರಂಭಿಸಿ"

msgid "Stop ciplushelper"
msgstr "ciplushelper ನಿಲ್ಲಿಸಿ"

msgid "Supported devices:"
msgstr "ಬೆಂಬಲಿತ ಸಾಧನಗಳು:"

