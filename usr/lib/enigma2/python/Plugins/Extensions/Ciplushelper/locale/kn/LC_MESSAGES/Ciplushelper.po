msgid "Are you sure you want to restart the GUI?"
msgstr "GUI ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?"

msgid "ARM"
msgstr "ARM"

