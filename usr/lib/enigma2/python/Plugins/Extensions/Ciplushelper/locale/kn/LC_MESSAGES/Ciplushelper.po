msgstr "ಸ್ಥಾಪಿಸಲಾಗಿದೆ:"

msgid "MIPSEL"
msgstr "MIPSEL"

msgid "Need restart GUI"
msgstr "GUI ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ"

msgid "Remove"
msgstr "ತೆಗೆದುಹಾಕಿ"

