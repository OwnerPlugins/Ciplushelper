msgstr "CI+ ಸಹಾಯಕ ಮೆನು"

msgid "CI+ Helper Plugin"
msgstr "CI+ ಸಹಾಯಕ ಪ್ಲಗಿನ್"

msgid "CI+ slot"
msgstr "CI+ ಸ್ಲಾಟ್"

